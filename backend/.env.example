# CampusFix backend environment example.
# Copy to backend/.env and fill in real values. Never commit the filled file.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- PostgreSQL (Supabase or another managed PostgreSQL) ------------------
# Use the pooled connection string for the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional direct connection for migrations (Supabase port 5432).
DIRECT_URL=
DATABASE_SSL=
DATABASE_SSL_VERIFY=
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300
DISABLE_RATE_LIMIT=

# Comma-separated frontend origins allowed to call the API directly.
# Production frontend on Vercel calls through a same-origin /api proxy.
CORS_ORIGINS=http://localhost:5000

# Optional display name for the institution in the interface.
COLLEGE_NAME=CampusFix

# --- One-time migration from the existing MongoDB database ----------------
# Only needed for backup/import. The running app does not use MongoDB.
MONGO_URI=
MONGODB_DB=
BACKUP_DIR=

# --- Initial administrator (create-admin script only) ----------------------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
